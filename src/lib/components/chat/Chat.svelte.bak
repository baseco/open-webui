<script lang="ts">
	// ... (rest of the code remains the same)

	const chatCompletedHandler = async (chatId, modelId, responseMessageId, messages) => {
		const res = await chatCompleted(localStorage.token, {
			model: modelId,
			messages: messages.map((m) => ({
				id: m.id,
				role: m.role,
				content: m.content,
				info: m.info ? m.info : undefined,
				timestamp: m.timestamp,
				...(m.usage ? { usage: m.usage } : {}),
				...(m.sources ? { sources: m.sources } : {})
			})),
			model_item: $models.find((m) => m.id === modelId),
			chat_id: chatId,
			session_id: $socket?.id,
			id: responseMessageId
		}).catch((error) => {
			toast.error(`${error}`);
			messages.at(-1).error = { content: error };

			return null;
		});

		if (res !== null && res.messages) {
			// Update chat history with the new messages
			for (const message of res.messages) {
				if (message?.id) {
					// Add null check for message and message.id
					history.messages[message.id] = {
						...history.messages[message.id],
						...(history.messages[message.id].content !== message.content
							? { originalContent: history.messages[message.id].content }
							: {}),
						...message
					};
				}
			}
		}

		await tick();

		if ($chatId == chatId) {
			if (!$temporaryChatEnabled) {
				chat = await updateChatById(localStorage.token, chatId, {
					models: selectedModels,
					messages: messages,
					history: history,
					params: params,
					files: chatFiles
				});

				currentChatPage.set(1);
				await chats.set(await getChatList(localStorage.token, $currentChatPage));
			}
		}

		// Refresh user info to update message count after chat completion
		try {
			console.log('Refreshing user info after message completion');
			const refreshedUserInfo = await getUserInfo(localStorage.token);
			console.log('User info from API:', refreshedUserInfo);
			
			if (refreshedUserInfo && $user) {
				console.log('Current user info in store:', $user);
				console.log('Current message count:', $user?.info?.message_count);
				
				// Update user store with the latest info including message count
				user.update(currentUser => {
					if (currentUser) {
						// Handle different API response structures
						if (refreshedUserInfo.message_count !== undefined) {
							console.log('Updating user store with direct message_count:', refreshedUserInfo.message_count);
							return {
								...currentUser,
								info: {
									...currentUser.info,
									message_count: refreshedUserInfo.message_count,
									message_limit: refreshedUserInfo.message_limit
								}
							};
						} else if (refreshedUserInfo.info && refreshedUserInfo.info.message_count !== undefined) {
							console.log('Updating user store with info object:', refreshedUserInfo.info);
							return {
								...currentUser,
								info: refreshedUserInfo.info
							};
						}
					}
					return currentUser;
				});
			}
		} catch (error) {
			console.error('Error refreshing user info after message completion:', error);
		}

		await tick();

		if ($chatId == chatId) {
			if (!$temporaryChatEnabled) {
				chat = await updateChatById(localStorage.token, chatId, {
					models: selectedModels,
					messages: messages,
					history: history,
					params: params,
					files: chatFiles
				});

				currentChatPage.set(1);
				await chats.set(await getChatList(localStorage.token, $currentChatPage));
			}
		}
	};

	// ... (rest of the code remains the same)
</script>

<svelte:head>
	<title>
		{$chatTitle
			? `${$chatTitle.length > 30 ? `${$chatTitle.slice(0, 30)}...` : $chatTitle} | ${$WEBUI_NAME}`
			: `${$WEBUI_NAME}`}
	</title>
</svelte:head>

